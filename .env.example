# Example environment variables for production deployment.
# Copy these into your host's dashboard (e.g. Render). Do NOT commit real values.

# Run the app in production mode (enables the Secure cookie flag).
NODE_ENV=production

# Directory for persistent files (SQLite DB + cookie secret).
# On Render this is the mounted disk path.
DATA_DIR=/data

# Random 32+ char string used to sign session cookies.
# On Render, use "generateValue: true" (already set in render.yaml).
SESSION_SECRET=change-me-to-a-long-random-string

# Login password, stored only as a scrypt hash + salt (never plaintext).
# Generate with:  npm run hash-password -- "your-password"
PASSWORD_SALT=93a73b58a3a7314b47926abbae822362
PASSWORD_HASH=5fcc7c2a9f4ebb70a008b937d2ea1c6495feefc7cf2868a299432bf28d02fabe8e900984957bb6dbbfa9a3a11f7800654de9b90a34c938a9feafae25818fafd0
